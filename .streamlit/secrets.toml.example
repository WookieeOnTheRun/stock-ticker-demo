# Copy to .streamlit/secrets.toml (git-ignored) and fill in real values locally. Never commit secrets.toml.
# Every key is optional: with none set, the app runs anonymously with all analytics and no saved state.
#
# --- Optional sign-in (Streamlit native OIDC auth; needs the streamlit[auth] extra, installed by default) ---
# Saved watchlists and settings need both [auth] and app_salt.
#
# app_salt = "<random string, e.g. python -c 'import secrets; print(secrets.token_urlsafe(32))'>"
#
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"    # must end in /oauth2callback; register it with the provider
# cookie_secret = "<python -c 'import secrets; print(secrets.token_urlsafe(48))'>"
# client_id = "<from your OpenID Connect provider>"
# client_secret = "<from your OpenID Connect provider>"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
